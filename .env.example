# Copy to .env.local and adjust. All values are optional; the defaults below
# match a backend and InfluxDB running locally.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time,
# so they are visible to anyone who can load the UI. Do not put production
# secrets here.

# Monitoring backend API (auth, dashboards, queries, servers, notifications).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# InfluxDB v2 HTTP API, used directly by the notification delete actions.
NEXT_PUBLIC_INFLUXDB_URL=http://localhost:8086

# InfluxDB organization ID sent with dashboard and notification requests.
NEXT_PUBLIC_INFLUXDB_ORG_ID=

# InfluxDB API token for the direct calls above (sent as "Token <value>").
# Use a scoped, low-privilege development token.
NEXT_PUBLIC_INFLUXDB_TOKEN=
